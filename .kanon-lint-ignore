# Rules to skip for specific paths
# Format: RULE/name:path/glob # reason
# Every entry requires justification.

# =============================================================================
# TESTING false positives
# =============================================================================

# WHY: parity_check() panics on tolerance failure — it IS the assertion;
# basanos does not recognize custom assertion functions as "verification signals".
TESTING/tautological-test:crates/kernels/tests/matmul_parity.rs

# WHY: phase_3_debug returns Result<(), TestError> — the ? operator is the
# verification signal; basanos does not recognize Result propagation as assertion.
TESTING/tautological-test:crates/logismos/tests/phase_3_debug.rs

# WHY: phase_3_fixture_check returns Result<(), TestError> — same as above.
TESTING/tautological-test:crates/logismos/tests/phase_3_fixture_check.rs

