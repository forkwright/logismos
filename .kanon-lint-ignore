# Phase 7 when the HIP kernel suite is complete.
TESTING/no-benchmarks:Cargo.toml

# WHY: Fuzz targets require the decode/parser surface to stabilize.
# Deferred to Phase 4+.
TESTING/no-fuzz:Cargo.toml

# =============================================================================
# ORCHESTRATION — main worktree commit rule
# =============================================================================

# WHY: Commit ac7e8d2 was authored in the main worktree during menos-down
# recovery window (verda is the compute host; dispatch infrastructure is
# degraded). One-time exception — future work uses worktrees.
ORCHESTRATION/main-worktree-commit-prohibited:Cargo.toml

